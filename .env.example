# Groq (primary provider) — https://console.groq.com/keys
GROQ_API_KEY=

# Open-weight models served by Groq. Check https://console.groq.com/docs/models for current IDs.
# Vision + tool calling (Qwen 3.8 27B, multimodal):
VISION_MODEL=qwen/qwen3.8-27b
# Text / planning / drafting (OpenAI gpt-oss-120b, Apache-2.0 open weights):
TEXT_MODEL=openai/gpt-oss-120b
# Optional: smaller model for drafting/translation (spreads Groq's per-model rate limits). Defaults to TEXT_MODEL.
HELPER_MODEL=openai/gpt-oss-20b

# Optional fallback provider (OpenAI-compatible endpoint serving open-weight models), e.g. OpenRouter
# or Hugging Face Inference Providers. With AI_PROVIDER=groq and FALLBACK_API_KEY set, Jaanch switches
# to it automatically when Groq returns a rate-limit / daily-quota / outage error (Groq's free tier has
# an ~8K tokens-per-minute and a tokens-per-day cap per model). Set AI_PROVIDER=openrouter to use it
# as the primary instead.
AI_PROVIDER=groq
FALLBACK_NAME=openrouter
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_API_KEY=
FALLBACK_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct
FALLBACK_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct
